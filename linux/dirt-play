#!/bin/sh
# dirt-play           show settings, then start Colin McRae: DiRT
# dirt-play --play    start with saved settings
# dirt-play stop      end the game
# dirt-play status    running or idle
#
# The session, lock, GPU choice, gamescope and prefix handling come from the
# shared rea-launcher-sdk play library (rea-play.sh; see its shell/README.md).
# What this game sets on top:
#  - a private Wine prefix at ~/.local/share/dirt-launcher/prefix
#  - gamescope at the launcher.cfg resolution with its scaler, skipped when
#    fullscreen = off (the game then sizes its own window)
#  - DXVK's d3d9.dll loaded before Wine's own (the launcher also writes it
#    as DiRT.exe's per-exe DLL override, for plain Proton)
#  - the session lasts until DiRT.exe exits (the launcher can return first
#    when it starts the game in an isolated Wine desktop)
#
# Environment: DIRT_PREFIX, DIRT_LAUNCHER, DIRT_RUN (e.g. "distrobox enter
# gaming --"), DIRT_WAIT (the AppImage), DIRT_GPU (GPU environment instead
# of the detected one; empty for none).
set -u

# The library: next to this script in a package, else the vendored copy.
# REA_FUNCTIONS_ONLY / REA_PLAY_HERE: the SDK's test convention.
_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=dirt-play

REA_APP=dirt-launcher
REA_EXE_NAME=DiRTLauncher.exe
REA_EXE_HINT=DIRT_LAUNCHER
REA_EXE=${DIRT_LAUNCHER:-}
REA_PREFIX=${DIRT_PREFIX:-}
REA_RUN=${DIRT_RUN:-}
REA_WAIT=${DIRT_WAIT:-}
[ -n "${DIRT_GPU+set}" ] && REA_GPU=$DIRT_GPU   # DIRT_GPU= for no GPU choice
REA_ALWAYS_WAIT=0                 # detached unless DIRT_WAIT (the AppImage)
REA_CFG_APPDATA=DiRTLauncher
REA_PLAY_ARGS="--no-window --linux"
REA_SDL_ENV=SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
REA_SDL_SETTINGS=0
REA_GAME_PROCS=DiRT.exe
REA_DLL_OVERRIDES='d3d9=n,b'     # the DXVK d3d9.dll the launcher puts in the copy
REA_WINDOWED_KEY=fullscreen       # fullscreen = off: no gamescope of our own
REA_WINDOWED_VALUES="off false no 0"
# Keys the helper reads itself: a play run's --scaler, --resolution or
# --fullscreen (e.g. dirt-play --play --scaler fsr) applies to that run.
REA_HELPER_KEYS="scaler resolution fullscreen"

rea_init || exit 1
# Tests load the configuration and hooks without running anything.
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
